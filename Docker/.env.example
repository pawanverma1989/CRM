# Copy this file to .env and fill in real values before running docker compose

# ── Database passwords ────────────────────────────────────────────────────────
IDENTITY_DB_PASSWORD=change_me_in_production
CUSTOMER_DB_PASSWORD=change_me_in_production

# ── Message broker ────────────────────────────────────────────────────────────
RABBITMQ_USER=crm_user
RABBITMQ_PASSWORD=change_me_in_production

# ── JWT signing key ───────────────────────────────────────────────────────────
# Generate RSA-2048 key pair:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste the full PEM content on one line (replace newlines with \n):
JWT_PRIVATE_KEY_PEM=

# ── Auth tuning (optional — defaults shown) ───────────────────────────────────
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_PWD_RESET_RATE_LIMIT=3

# ── Frontend origin for CORS (default: http://localhost) ─────────────────────
FRONTEND_ORIGIN=http://localhost

# ── API base URL injected into the frontend at container startup ──────────────
# Read at runtime by the container entrypoint and written to env-config.js,
# which the browser loads before the React bundle. Changing this value takes
# effect on the next container restart — no image rebuild required.
# Default (/api/identity/v1) is a relative path that works behind nginx.
# Set to an absolute URL (e.g. http://localhost/api/identity/v1) when
# accessing the frontend directly on port 3000 instead of through nginx.
VITE_API_URL=/api/identity/v1

# ── Customer service tuning (optional — defaults shown) ───────────────────────
# Days a soft-deleted company/contact stays in the recycle bin before purge (DEL-2).
CUSTOMER_RECYCLE_BIN_DAYS=30
# Max records accepted by /reassign and /bulk-delete in one call (OWN-2, DEL-4).
CUSTOMER_MAX_BULK_RECORDS=500
# Max rows accepted by /bulk-upsert in one call (NFR-3: 1,000 rows < 10 s).
CUSTOMER_MAX_IMPORT_ROWS=1000
# Max active custom field definitions per record type (CF-7).
CUSTOMER_MAX_CUSTOM_FIELDS=50

# ── Customer frontend API base URLs ───────────────────────────────────────────
# Read at container startup by the customer frontend entrypoint and written to
# env-config.js (same mechanism as VITE_API_URL above). The SPA is served under
# the /customer/ path prefix by nginx; these defaults are relative paths that
# work behind nginx. Use absolute URLs (e.g. http://localhost/api/customer/v1)
# when hitting the frontend directly on port 3001.
CUSTOMER_VITE_API_URL=/api/customer/v1
VITE_IDENTITY_API_URL=/api/identity/v1
