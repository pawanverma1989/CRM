{
  "ConnectionStrings": {
    "CustomerDb": "Host=customer-db;Port=5432;Database=customer_db;Username=customer_svc;Password=change_me;Pooling=true;MinPoolSize=2;MaxPoolSize=20"
  },
  "Jwt": {
    "Issuer": "crm-identity",
    "Audience": "crm-services"
  },
  "Identity": {
    "JwksUrl": "http://identity-api:8080/.well-known/jwks.json",
    "JwksCacheMinutes": 60,
    "JwksTimeoutSeconds": 5,
    "JwksRetryCount": 3
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "crm_user",
    "Password": "change_me",
    "VirtualHost": "/",
    "Exchange": "crm.customer.events",
    "ConsumeExchanges": ["crm.identity.events", "crm.compliance.events"],
    "Queue": "crm.customer.inbox",
    "ConsumeRoutingKeys": [
      "user.created",
      "user.updated",
      "user.deactivated",
      "dsr.erasure_requested",
      "dsr.access_requested"
    ],
    "DeadLetterExchange": "crm.customer.dlx",
    "MaxDeliveryAttempts": 5,
    "RelayPollSeconds": 2,
    "RelayBatchSize": 100,
    "RelayBackoffSeconds": 5
  },
  "Customer": {
    "RecycleBinRetentionDays": 30,
    "MaxBulkRecords": 500,
    "MaxImportRowsPerCall": 1000,
    "BulkUpsertChunkSize": 200,
    "MaxActiveCustomFields": 50,
    "MaxTagsPerRecord": 20,
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "SimilarityThreshold": 0.4,
    "MaxDuplicateWarnings": 10,
    "DsrExportPath": "/var/crm/dsr-exports",
    "PurgeIntervalHours": 24,
    "DefaultPhoneCountryCode": "91",
    "DefaultCountry": "IN"
  },
  "Workers": {
    "OutboxRelayEnabled": true,
    "ConsumerEnabled": true,
    "PurgeEnabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }]
  },
  "AllowedOrigins": ["http://localhost", "http://localhost:3001"]
}
