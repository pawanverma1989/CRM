# Customer micro-frontend runtime configuration.
# Both values are injected into window.__ENV__ by entrypoint.sh at container
# start, so the image does not need rebuilding when a URL changes.

# Customer service API, behind the shared nginx gateway
VITE_API_URL=/api/customer/v1

# Identity service API — used only to exchange the shared refresh token
# (localStorage key "crm_refresh_token") for an access token.
VITE_IDENTITY_API_URL=/api/identity/v1
