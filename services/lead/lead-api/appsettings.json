{
  "ConnectionStrings": {
    "LeadDb": "Host=lead-db;Port=5432;Database=lead_db;Username=lead_svc;Password=change_me;Pooling=true;MinPoolSize=2;MaxPoolSize=20"
  },
  "Jwt": {
    "Issuer": "crm-identity",
    "Audience": "crm-services"
  },
  "Identity": {
    "JwksUrl": "http://identity-api:8080/.well-known/jwks.json",
    "JwksCacheMinutes": 60,
    "JwksTimeoutSeconds": 5,
    "JwksRetryCount": 3
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "crm_user",
    "Password": "change_me",
    "VirtualHost": "/",
    "Exchange": "crm.lead.events",
    "Queue": "crm.lead.inbox",
    "ConsumeExchanges": [
      "crm.identity.events",
      "crm.compliance.events",
      "crm.activity.events",
      "crm.customer.events",
      "crm.sales.events"
    ],
    "ConsumeRoutingKeys": [
      "user.created",
      "user.updated",
      "user.deactivated",
      "dsr.erasure_requested",
      "activity.logged",
      "contact.merged",
      "company.merged",
      "deal.deleted"
    ],
    "DeadLetterExchange": "crm.lead.dlx",
    "MaxDeliveryAttempts": 5,
    "RelayPollSeconds": 5,
    "RelayBatchSize": 50
  },
  "Lead": {
    "RecycleBinRetentionDays": 30,
    "MaxBulkRecords": 500,
    "MaxImportRowsPerCall": 1000,
    "MaxActiveCustomFields": 50,
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "MaxConversionRetries": 5,
    "WebFormSubmissionsPerIpPerHour": 10,
    "DuplicateCheckWindowDays": 30,
    "DefaultPhoneCountryCode": "91",
    "PurgeIntervalHours": 24
  },
  "Workers": {
    "OutboxRelayEnabled": true,
    "ConsumerEnabled": true,
    "ConversionRetryEnabled": true,
    "PurgeEnabled": true
  },
  "ServiceClients": {
    "CustomerApiBaseUrl": "http://customer-api:8080",
    "SalesApiBaseUrl": "http://sales-api:8080",
    "ServiceToken": "",
    "TimeoutSeconds": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }]
  },
  "AllowedOrigins": ["http://localhost", "http://localhost:3003"]
}
