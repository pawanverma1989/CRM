{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }]
  },
  "ConnectionStrings": {
    "SalesDb": "Host=localhost;Port=5432;Database=sales_db;Username=sales_svc;Password=change_me;Pooling=true"
  },
  "Jwt": {
    "Issuer": "crm-identity",
    "Audience": "crm-services"
  },
  "Identity": {
    "JwksUrl": "http://localhost:8080/.well-known/jwks.json",
    "JwksCacheMinutes": 60,
    "JwksTimeoutSeconds": 5,
    "JwksRetryCount": 3
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "crm_user",
    "Password": "change_me",
    "Exchange": "crm.sales.events",
    "Queue": "sales.consumer",
    "DeadLetterExchange": "crm.sales.events.dead",
    "ConsumeExchanges": [
      "crm.activity.events",
      "crm.customer.events",
      "crm.identity.events",
      "crm.compliance.events"
    ],
    "ConsumeRoutingKeys": [
      "company.*",
      "contact.*",
      "activity.logged",
      "user.created",
      "user.updated",
      "user.deactivated",
      "dsr.erasure_requested"
    ],
    "RelayPollSeconds": 5,
    "RelayBatchSize": 100,
    "MaxDeliveryAttempts": 5
  },
  "Sales": {
    "RecycleBinRetentionDays": 30,
    "MaxBulkRecords": 500,
    "MaxImportRowsPerCall": 1000,
    "MaxActiveCustomFields": 50,
    "DefaultPageSize": 50,
    "MaxPageSize": 200,
    "StaleDaysWithoutActivity": 14,
    "StaleDaysInStage": 30,
    "PurgeIntervalHours": 24
  },
  "Workers": {
    "OutboxRelayEnabled": true,
    "EventConsumerEnabled": true,
    "PurgeWorkerEnabled": true
  },
  "AllowedOrigins": [ "http://localhost" ],
  "Seeder": { "RunOnStartup": true }
}
